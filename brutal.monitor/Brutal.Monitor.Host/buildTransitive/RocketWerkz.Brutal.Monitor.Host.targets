<Project>
  <!-- NuGet extraction does not preserve executable permissions for the NativeAOT watchdog. -->
  <Target
    Name="MakeMonitorBuildExecutable"
    AfterTargets="CopyFilesToOutputDirectory"
    Condition="!$([MSBuild]::IsOSPlatform('Windows')) and '$(TargetDir)' != ''"
  >
    <ItemGroup>
      <_MonitorBuildExecutable Include="$(TargetDir)Brutal.Monitor.Subprocess;$(TargetDir)runtimes/*/native/Brutal.Monitor.Subprocess" />
    </ItemGroup>
    <Exec
      Command="chmod +x &quot;%(_MonitorBuildExecutable.Identity)&quot;"
      Condition="Exists('%(_MonitorBuildExecutable.Identity)')"
    />
  </Target>
  <Target
    Name="MakeMonitorPublishExecutable"
    AfterTargets="Publish"
    Condition="!$([MSBuild]::IsOSPlatform('Windows')) and '$(PublishDir)' != ''"
  >
    <ItemGroup>
      <_MonitorPublishExecutable Include="$(PublishDir)Brutal.Monitor.Subprocess;$(PublishDir)runtimes/*/native/Brutal.Monitor.Subprocess" />
    </ItemGroup>
    <Exec
      Command="chmod +x &quot;%(_MonitorPublishExecutable.Identity)&quot;"
      Condition="Exists('%(_MonitorPublishExecutable.Identity)')"
    />
  </Target>
</Project>
